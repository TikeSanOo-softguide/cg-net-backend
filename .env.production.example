APP_NAME="YNO Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yno-admin.chocobot.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

AUTH_GUARD=web
AUTH_PASSWORD_BROKER=admins

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cg_net
DB_USERNAME=cgnet
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.chocobot.site
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@chocobot.site"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="YNO Admin"
VITE_REVERB_ENABLED=false
