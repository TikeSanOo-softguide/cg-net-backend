# This file documents the production environment. Copy it to .env on the server,
# replace every placeholder, and chmod 600 .env. Never commit the real .env.

# Make plain "docker compose" commands select the production stack on the server.
COMPOSE_FILE=docker-compose.prod.yml

# Use a unique immutable release tag (for example, a Git commit SHA) for each deployment.
APP_TAG=replace-with-release-tag

# Laravel application display name.
APP_NAME="YNO Admin"
# Laravel environment; keep production on the server.
APP_ENV=production
# Disable detailed errors in production.
APP_DEBUG=false
# Generate a unique key for this production environment; never reuse the dev key.
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
# Public HTTPS URL of the application.
APP_URL=https://your-domain.example
# Timezone used by Laravel.
APP_TIMEZONE=UTC

# Write application logs to container stdout/stderr.
LOG_CHANNEL=stderr
# Log only errors in production; adjust according to the log retention policy.
LOG_LEVEL=error

# Use PostgreSQL hosted on the separate private database server.
DB_CONNECTION=pgsql
# Private IP or private DNS name of the PostgreSQL server, reachable from this host.
DB_HOST=10.0.0.10
# PostgreSQL listener port.
DB_PORT=5432
# Production database name.
DB_DATABASE=replace_with_production_database
# Least-privilege PostgreSQL application user.
DB_USERNAME=replace_with_production_user
# Unique strong production-only password.
DB_PASSWORD=replace_with_unique_production_password
# Require TLS for the PostgreSQL connection.
DB_SSLMODE=require

# Redis-backed application cache.
CACHE_STORE=redis
# Use Redis-backed Laravel queues for Horizon.
QUEUE_CONNECTION=redis
# Share sessions across PHP containers using Redis.
SESSION_DRIVER=redis
# Session lifetime in minutes.
SESSION_LIFETIME=120
# Encrypt session data at rest in the session store.
SESSION_ENCRYPT=true
# Send session cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
# Restrict cross-site cookie sending to same-site requests.
SESSION_SAME_SITE=lax
# Store user uploads in durable remote storage in production, not the container filesystem.
FILESYSTEM_DISK=local
# Production AWS region for the S3-compatible object storage bucket.
AWS_DEFAULT_REGION=replace_with_region
# Name of the production upload bucket.
AWS_BUCKET=replace_with_production_bucket
# Unique production-only object storage access key.
AWS_ACCESS_KEY_ID=replace_with_production_access_key
# Unique production-only object storage secret key.
AWS_SECRET_ACCESS_KEY=replace_with_production_secret_key
# Optional public URL for the bucket; leave empty to use Laravel's generated URL.
AWS_URL=
# Optional S3-compatible endpoint; leave empty for AWS S3.
AWS_ENDPOINT=
# Whether to use path-style S3 URLs; usually false for AWS S3.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Send broadcast events to Reverb.
BROADCAST_CONNECTION=reverb

# Use the phpredis PHP extension.
REDIS_CLIENT=phpredis
# Redis runs privately in this Compose stack.
REDIS_HOST=redis
# Redis internal listener port.
REDIS_PORT=6379
# Unique strong production-only password (use URL-safe characters).
REDIS_PASSWORD=replace_with_unique_production_redis_password
# Limit Redis memory; size this against the host's available RAM.
REDIS_MAXMEMORY=512mb

# Reverb application identifier; unique to production.
REVERB_APP_ID=replace_with_production_reverb_id
# Public Reverb application key, also passed to the browser build.
REVERB_APP_KEY=replace_with_production_reverb_public_key
# Private server-side Reverb secret; never expose it to Vite/browser builds.
REVERB_APP_SECRET=replace_with_unique_production_reverb_secret
# Reverb binds inside the Docker network on all interfaces.
REVERB_SERVER_HOST=0.0.0.0
# Internal Reverb listener port.
REVERB_SERVER_PORT=8080
# Internal hostname used by PHP to send broadcasts to Reverb.
REVERB_HOST=reverb
# Internal Reverb port used by PHP.
REVERB_PORT=8080
# Internal PHP-to-Reverb transport scheme.
REVERB_SCHEME=http

# Vite variables below are compiled into browser assets at image build time.
# Enable Reverb in the production JavaScript bundle.
VITE_REVERB_ENABLED=true
# Public Reverb key only; it must match REVERB_APP_KEY and is not a secret.
VITE_REVERB_APP_KEY=replace_with_production_reverb_public_key
# Public hostname served by the HTTPS ingress.
VITE_REVERB_HOST=your-domain.example
# Public secure WebSocket port exposed by the HTTPS ingress.
VITE_REVERB_PORT=443
# Use secure WebSockets from browsers.
VITE_REVERB_SCHEME=https
# Browser title compiled into the frontend.
VITE_APP_NAME="YNO Admin"

# Bind Nginx only to the host's loopback when a host proxy or local ingress terminates TLS.
# For a direct load balancer connection, set to the appropriate interface/port mapping.
NGINX_PORT=127.0.0.1:8080
