{
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "trailingComma": "all",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "plugins": ["@prettier/plugin-php"],
    "phpVersion": "8.3",
    "braceStyle": "per-cs",
    "overrides": [
        {
            "files": "*.php",
            "options": {
                "parser": "php"
            }
        }
    ]
}
