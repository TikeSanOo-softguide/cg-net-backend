FROM php:8.3-fpm-alpine AS php-base

RUN apk add --no-cache \
        ca-certificates \
        curl \
        freetype \
        icu-libs \
        libjpeg-turbo \
        libpng \
        libpq \
        libzip \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        curl-dev \
        freetype-dev \
        icu-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libzip-dev \
        oniguruma-dev \
        postgresql-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        curl \
        exif \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_pgsql \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

FROM php-base AS composer-deps

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN COMPOSER_ALLOW_SUPERUSER=1 composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-scripts \
    --no-progress

COPY . .
RUN COMPOSER_ALLOW_SUPERUSER=1 composer dump-autoload \
        --no-dev \
        --classmap-authoritative \
        --no-scripts \
    && php artisan package:discover --ansi

FROM node:22-alpine AS assets

WORKDIR /var/www/html

ARG VITE_APP_NAME
ARG VITE_REVERB_ENABLED=false
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https

ENV VITE_APP_NAME="${VITE_APP_NAME}" \
    VITE_REVERB_ENABLED="${VITE_REVERB_ENABLED}" \
    VITE_REVERB_APP_KEY="${VITE_REVERB_APP_KEY}" \
    VITE_REVERB_HOST="${VITE_REVERB_HOST}" \
    VITE_REVERB_PORT="${VITE_REVERB_PORT}" \
    VITE_REVERB_SCHEME="${VITE_REVERB_SCHEME}"

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .
RUN npm run build

FROM php-base AS runtime

WORKDIR /var/www/html

COPY --from=composer-deps --chown=www-data:www-data /var/www/html /var/www/html
COPY --from=assets --chown=www-data:www-data /var/www/html/public/build /var/www/html/public/build
COPY --chown=root:root docker/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh

RUN printf '%s\n' \
        'memory_limit=256M' \
        'upload_max_filesize=32M' \
        'post_max_size=32M' \
        'max_execution_time=60' \
        'opcache.enable=1' \
        'opcache.enable_cli=0' \
        'opcache.memory_consumption=192' \
        'opcache.interned_strings_buffer=16' \
        'opcache.max_accelerated_files=20000' \
        'opcache.validate_timestamps=0' \
        'opcache.revalidate_freq=0' \
        'opcache.max_wasted_percentage=10' \
        'opcache.jit=off' \
        > /usr/local/etc/php/conf.d/zz-production.ini \
    && printf '%s\n' \
        '[global]' \
        'pid = /tmp/php-fpm.pid' \
        'error_log = /proc/self/fd/2' \
        'daemonize = no' \
        '[www]' \
        'listen = 9000' \
        'user = www-data' \
        'group = www-data' \
        'pm = dynamic' \
        'pm.max_children = 20' \
        'pm.start_servers = 4' \
        'pm.min_spare_servers = 2' \
        'pm.max_spare_servers = 6' \
        'pm.max_requests = 500' \
        'request_terminate_timeout = 120s' \
        'catch_workers_output = yes' \
        'decorate_workers_output = no' \
        > /usr/local/etc/php-fpm.d/zz-production.conf \
    && mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod 0555 /usr/local/bin/entrypoint.prod.sh

USER www-data

ENTRYPOINT ["/usr/local/bin/entrypoint.prod.sh"]
CMD ["php-fpm", "-F"]

FROM nginx:1.29-alpine AS nginx

COPY --from=assets --chown=101:101 /var/www/html/public/ /usr/share/nginx/html/
COPY --chown=101:101 docker/nginx/prod.conf /etc/nginx/nginx.conf

USER 101:101
EXPOSE 8080

FROM redis:7.4-alpine AS redis

RUN chown redis:redis /data

USER redis
